; Fragmento de project.godot - seccion [input] que una IA sin editor puede escribir
; a mano. CLAVE: usa physical_keycode (posicion fisica, layout-independiente) y NO
; keycode, o WASD se rompe en teclados AZERTY/QWERTZ. 87 = W fisica, 65 = A, 83 = S,
; 68 = D. Tras editar a mano corre: godot --headless --import
; (4.6 ya no escribe load_steps; recursos usan uid:// desde 4.4).

[input]

move_forward={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":87)
, Object(InputEventJoypadMotion,"axis":1,"axis_value":-1.0)]
}
move_back={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":83)
, Object(InputEventJoypadMotion,"axis":1,"axis_value":1.0)]
}
move_left={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":65)
, Object(InputEventJoypadMotion,"axis":0,"axis_value":-1.0)]
}
move_right={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":68)
, Object(InputEventJoypadMotion,"axis":0,"axis_value":1.0)]
}
attack={
"deadzone": 0.2,
"events": [Object(InputEventMouseButton,"button_index":1)
, Object(InputEventJoypadButton,"button_index":2)]
}
