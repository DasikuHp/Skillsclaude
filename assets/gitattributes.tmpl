# ===== Godot 4.6 .gitattributes =====
# Texto de Godot a LF: evita diffs gigantes y corrupcion Win<->Linux<->macOS.
# En 4.6 los .tscn ya NO escriben load_steps, asi que LF mantiene los diffs estables.
* text=auto eol=lf

*.gd      text eol=lf
*.tscn    text eol=lf
*.tres    text eol=lf
*.godot   text eol=lf
*.import  text eol=lf
*.uid     text eol=lf
*.cfg     text eol=lf
*.csv     text eol=lf
*.cs      text eol=lf diff=csharp

# Binarios: ni diff ni conversion de EOL
*.png   binary
*.jpg   binary
*.webp  binary
*.exr   binary
*.ogg   binary
*.wav   binary
*.mp3   binary
*.glb   binary
*.gltf  binary
*.fbx   binary
*.blend binary
*.ttf   binary
*.res   binary
*.scn   binary

# ===== Opcional: Git LFS para assets pesados de un RPG 3D =====
# Flujo: 'git lfs install' -> commitear ESTE .gitattributes -> LUEGO anadir binarios.
# Si los anades antes, corrige con: git lfs migrate import --include="*.glb,*.png"
# *.glb  filter=lfs diff=lfs merge=lfs -text
# *.png  filter=lfs diff=lfs merge=lfs -text
# *.exr  filter=lfs diff=lfs merge=lfs -text
# *.ogg  filter=lfs diff=lfs merge=lfs -text
# *.wav  filter=lfs diff=lfs merge=lfs -text
# NOTA: nunca pongas .tscn/.tres/.gd en LFS (son texto, los necesitas para diff/merge).
